{
  "version": "system-sentinel-contract-2026-08-20-v1",
  "authority": "advisory_only",
  "required_boundaries": [
    "valuation",
    "accounting",
    "execution",
    "risk",
    "startup_runtime",
    "configuration",
    "architecture",
    "runner",
    "market_data"
  ],
  "incident_schema": [
    "incident_id",
    "severity",
    "boundary",
    "reason_code",
    "evidence",
    "suspected_cause",
    "confidence",
    "proposed_fix",
